# Tavily API (поиск компаний)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# Firecrawl API (обогащение данных)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxx

# Google Gemini API (генерация КП)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.8-flash
# Резервный LLM через OpenRouter (используется при сбое Gemini)
AI_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Telegram Bot (уведомления)
TELEGRAM_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxxxxxxxxxxxx

# База данных PostgreSQL (обязательна в production; локально можно без неё).
# Строка подключения: Supabase -> Project Settings -> Database -> Connection String -> URI
DATABASE_URL=
# Разовый импорт отсутствующих JSON-записей в пустую/действующую БД.
# Включать только вручную и удалить после успешного первого запуска.
IMPORT_JSON_SEED=false

# Сервер
PORT=3001

# Безопасность
# Секрет подписи JWT (длинная случайная строка)
JWT_SECRET=
# Аккаунт администратора (создаётся при первом старте, если нет пользователей)
ADMIN_EMAIL=admin@leadpipeline.local
ADMIN_PASSWORD=
# Через сколько секунд можно повторно запускать поиск (по умолчанию 120)
RUN_COOLDOWN_SECONDS=120
# Максимум одновременных повторных проверок сайта
MAX_CONCURRENT_RECHECKS=2
# Список разрешённых доменов для CORS через запятую (по умолчанию зашит Vercel+localhost)
# ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:5173
