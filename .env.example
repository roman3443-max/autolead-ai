# Tavily API (поиск компаний)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# Firecrawl API (обогащение данных)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxx

# Google Gemini API (генерация КП)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx

# Telegram Bot (уведомления)
TELEGRAM_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxxxxxxxxxxxx

# Сервер
PORT=3001

# Безопасность (опционально)
# Если задать API_TOKEN, все /api-запросы требуют заголовок x-api-token.
# Фронтенд попросит ввести этот ключ при первом обращении и запомнит в браузере.
API_TOKEN=
# Через сколько секунд можно повторно запускать поиск (по умолчанию 120)
RUN_COOLDOWN_SECONDS=120
# Список разрешённых доменов для CORS через запятую (по умолчанию зашит Vercel+localhost)
# ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:5173